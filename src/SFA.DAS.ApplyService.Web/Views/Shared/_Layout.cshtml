@using NPOI.HSSF.Record
@using SFA.DAS.ApplyService.Configuration
@using SFA.DAS.ApplyService.Session
@inject ISessionService SessionService
@inject IConfigurationService Config
@inject IApplyConfig ApplyConfig
@{ var cdnBaseUrl = ApplyConfig.CdnBaseUrl?.TrimEnd('/'); }
<!DOCTYPE html>
<html lang="en" class="govuk-template govuk-template--rebranded dfe-branding">
<head>
    <environment exclude="Development">
        <!-- Data Layer  -->
        <script>
            dataLayer = [{
                'vpv': '@Context.Request.Path'
            }];
        </script>
        <!-- End Data Layer  -->

        <!-- Google Tag Manager -->
        <script>
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({
                    'gtm.start':
                        new Date().getTime(),
                    event: 'gtm.js'
                });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l !== 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', 'GTM-KVSLVQ9');
        </script>
        <!-- End Google Tag Manager -->
    </environment>

    <meta charset="utf-8"/>
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1d70b8" />
    <link rel="icon" sizes="48x48" href="@cdnBaseUrl/assets/rebrand/images/favicon.ico" />
    <link rel="icon" sizes="any" href="@cdnBaseUrl/assets/rebrand/images/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="@cdnBaseUrl/assets/rebrand/images/govuk-icon-mask.svg" color="#1d70b8" />
    <link rel="apple-touch-icon" href="@cdnBaseUrl/assets/rebrand/images/govuk-icon-180.png" />
    <link href="@cdnBaseUrl/css/main.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)

    <environment include="Development">
        <link rel="stylesheet" href="/stylesheets/application.css">
    </environment>

    <environment exclude="Development">
        <link rel="stylesheet" href="/stylesheets/application.min.css">
    </environment>
    
</head>

<body class="govuk-template__body ">

<script>
    /* append the .js-enabled class when this script block runs as javascript is enabled  */
    document.body.className = ((document.body.className) ? document.body.className + ' js-enabled' : 'js-enabled');
</script>

<environment exclude="Development">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe title="Google Tag Manager" src="https://www.googletagmanager.com/ns.html?id=GTM-KVSLVQ9" height="0" width="0" style="display: none; visibility: hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
</environment>

<a href="#main-content" class="govuk-skip-link">Skip to main content</a>
@{ var config = await Config.GetConfig(); }


<div data-module="cookie-banner" role="region" aria-label="cookie banner">
   <div class="das-cookie-banner">
      <div class="das-cookie-banner__wrapper govuk-width-container">
         <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
               <h2 class="govuk-heading-m das-cookie-banner__header">Tell us whether you accept cookies</h2>
                        <p class="govuk-body">We use <a asp-controller="Home" asp-action="Cookies" class="govuk-link govuk-link--no-visited-state">cookies to collect information</a> about how you use the apprenticeship provider and assessment register service. We use this information to make the website work as well as possible and improve the service.</p>
               <div class="das-cookie-banner__buttons">
                  <div class="das-cookie-banner__button-wrap das-cookie-banner__button-accept">
                     <button class="govuk-button das-button--outline das-cookie-banner__button" type="submit" data-accept-cookies="true">Accept all cookies</button>
                  </div>
                  <div class="das-cookie-banner__button-wrap das-cookie-banner__button-settings">
                     <a class="govuk-button das-button--outline das-cookie-banner__button" role="button" asp-controller="Home" asp-action="Cookies">Set cookie preferences</a>
                  </div>
               </div>
            </div>
         </div>
      </div>
      <div class="das-cookie-banner__confirmation govuk-width-container" tabindex="-1">
         <p class="govuk-body das-cookie-banner__confirmation-message">
            You've accepted all cookies. You can <a class="govuk-link" asp-controller="Home" asp-action="Cookies">change your cookie settings</a> at any time.
         </p>
         <button class="das-cookie-banner__hide-button" data-hide-cookie-banner="true">Hide</button>
      </div>
   </div>
</div>

<header class="rebranded-cross-service-header dfe-branding" data-module="one-login-header">
    <div class="rebranded-one-login-header" data-one-login-header-nav>
        <div class="rebranded-one-login-header__container govuk-width-container">
            <div class="rebranded-one-login-header__logo">
                <a
                    href="https://www.gov.uk/"
                    class="rebranded-one-login-header__link rebranded-one-login-header__link--homepage das-header__dfe-logo-link"
                >
                    <img src="@cdnBaseUrl/images/department-for-education_white.png" alt="Department for Education" class="das-header__dfe-logo" />
                </a>
            </div>
      
        </div>
    </div>

    <section aria-label="Service information" class="govuk-service-navigation das-header__navigation">
        <div class="govuk-width-container">
            <div class="govuk-service-navigation__container das-header__navigation__container">
                <div class="das-header__service-user-name-wrap">
                    <span class="govuk-service-navigation__service-name">
                        <a href="/" class="govuk-service-navigation__link">
                            Apprenticeship provider and assessment register service
                        </a>
                    </span>
                </div>
            </div>
        </div>
    </section>
</header>

<div class="govuk-width-container">
    @if(IsSectionDefined("Navigation"))
    {
        @RenderSection("Navigation")
    }
    else if (User.Identity.IsAuthenticated)
    {
        <nav>
            <ul id="navigation" class="roatp__navigation " aria-label="Top Level Navigation" role="navigation">
                <li class="roatp__navigation-item roatp__navigation-item--signout">
                    <a class="govuk-link govuk-link--no-visited-state" asp-action="SignOut" asp-controller="Users">Sign out</a>
                </li>
            </ul>
        </nav>
    }
</div>
<div class="govuk-width-container">
    @await RenderSectionAsync("breadcrumb", required: false)
</div>
<div class="govuk-width-container">
    @RenderBody()
</div>

